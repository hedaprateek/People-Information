{
  // Config for deploying as a Worker with static assets.
  // Not needed if the project was created as a Cloudflare *Pages* project —
  // there, functions/_middleware.js is picked up on its own.
  "$schema": "node_modules/wrangler/config-schema.json",

  // Must match the Worker in your Cloudflare account, or a deploy either fails
  // or quietly creates a second Worker at a different address.
  "name": "people-information",
  "main": "worker.js",
  "compatibility_date": "2025-04-01",

  "assets": {
    "directory": "./",
    "binding": "ASSETS",

    // Without this, Cloudflare serves any matching file straight from the edge
    // and never invokes the Worker — so data.xlsx and the PDFs would be public
    // no matter what the gate says. This single line is what makes the
    // password gate real on this platform.
    "run_worker_first": true
  },

  "observability": { "enabled": true }

  // EMAIL LOGIN IS OPTIONAL and deliberately not configured here.
  //
  // A kv_namespaces entry with a placeholder id makes Cloudflare REJECT the
  // whole deployment, which silently leaves the site ungated. Only add this
  // once you have created the namespace (Storage -> KV) and have its real id:
  //
  //   "kv_namespaces": [
  //     { "binding": "OTP", "id": "the-real-32-char-id" }
  //   ],
  //
  // Without it the email box simply does not appear; access codes still work.

  // Set SITE_PASSWORDS and SESSION_SECRET in the dashboard
  // (Settings -> Variables and Secrets), not here — this file is public.
}
